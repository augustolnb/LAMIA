# Chave da API DeepSeek (usada via LiteLLM — endpoint OpenAI-compatible nativo da DeepSeek)
DEEPSEEK_API_KEY=

# Caminho do CSV de casos clínicos (mtsamples) — default: data/mtsamples.csv
DATA_CSV_PATH=data/mtsamples.csv

# Quantidade total de casos reais amostrados na demo (default: 20)
N_CASOS_AMOSTRA=20
